#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Material "Constant"
    {
        token outputs:surface.connect = </World/Constant/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.08, 0.35, 0.025)
            float inputs:roughness = 0.8
            token outputs:surface
        }
    }

    def Material "Reader"
    {
        token outputs:surface.connect = </World/Reader/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.08, 0.35, 0.025)
            color3f inputs:diffuseColor.connect = </World/Reader/Reader.outputs:result>
            float inputs:roughness = 0.8
            token outputs:surface
        }

        def Shader "Reader"
        {
            uniform token info:id = "UsdPrimvarReader_float3"
            float3 inputs:fallback = (0.08, 0.35, 0.025)
            string inputs:varname = "displayColor"
            float3 outputs:result
        }
    }

    def Mesh "ConstantControl" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        float3[] extent = [(-0.89, -0.35, 0), (-0.41, 0.35, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </World/Constant>
        point3f[] points = [(-0.89, -0.35, 0), (-0.41, -0.35, 0), (-0.41, 0.35, 0), (-0.89, 0.35, 0)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "PresentPrimvar" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        float3[] extent = [(-0.24, -0.35, 0), (0.24, 0.35, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </World/Reader>
        point3f[] points = [(-0.24, -0.35, 0), (0.24, -0.35, 0), (0.24, 0.35, 0), (-0.24, 0.35, 0)]
        color3f[] primvars:displayColor = [(0.08, 0.35, 0.025)] (
            interpolation = "constant"
        )
        uniform token subdivisionScheme = "none"
    }

    def Mesh "AbsentPrimvarFallback" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        float3[] extent = [(0.41, -0.35, 0), (0.89, 0.35, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </World/Reader>
        point3f[] points = [(0.41, -0.35, 0), (0.89, -0.35, 0), (0.89, 0.35, 0), (0.41, 0.35, 0)]
        uniform token subdivisionScheme = "none"
    }
}
