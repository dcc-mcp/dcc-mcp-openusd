#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "Body" (
        customData = { string MayaType = "mesh" }
        prepend references = @./assets/missing_body.usda@
    )
    {
        rel material:binding = </World/Materials/BodyMat>
    }

    def Scope "Materials"
    {
        def Material "BodyMat"
        {
            token outputs:surface.connect = </World/Materials/BodyMat/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                token outputs:surface
            }
        }
    }
}
