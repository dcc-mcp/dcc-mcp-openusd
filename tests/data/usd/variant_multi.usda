#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Mesh "Cube"
    {
        rel material:binding = </Root/Looks/BlueMat>
    }

    def Scope "Looks"
    {
        variantSet "shading" = {
            "red" {
                def Material "RedMat"
                {
                    token outputs:surface.connect = </Root/Looks/RedMat/Shader.outputs:surface>

                    def Shader "Shader"
                    {
                        uniform token info:id = "UsdPreviewSurface"
                        token outputs:surface
                    }
                }
            }
            "blue" {
                def Material "BlueMat"
                {
                    token outputs:surface.connect = </Root/Looks/BlueMat/Shader.outputs:surface>

                    def Shader "Shader"
                    {
                        uniform token info:id = "UsdPreviewSurface"
                        token outputs:surface
                    }
                }
            }
        }
    }
}
